# CRON_SECRET — shared secret for Vercel Cron to call /api/keepalive.
# Generate with: openssl rand -hex 32
# Required length: 16+ chars. Fail-closed: unset/empty → all requests get 401.
# Set in Vercel Production env (and any preview env that runs the cron).
# Never commit a real value.
CRON_SECRET=

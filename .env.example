# ============================================================
#  Database (PostgreSQL)
#  Use the credentials from docker-compose.yml for local dev.
# ============================================================
DATABASE_URL=postgresql://mliga:mliga@localhost:5432/mliga

# Prisma 7+ requires a direct connection URL for migrations.
# In local dev this is the SAME as DATABASE_URL.
# In production with a connection pooler, this bypasses the pooler.
DIRECT_URL=postgresql://mliga:mliga@localhost:5432/mliga

# ============================================================
#  Better Auth
# ============================================================
# Base URL of the app (must match the origin you access it from)
BETTER_AUTH_URL=http://localhost:3000

# Strong random secret — minimum 32 characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# (Optional) Comma-separated list of extra trusted origins
# BETTER_AUTH_TRUSTED_ORIGINS=

# ============================================================
#  Cron / Keep-alive endpoint
# ============================================================
# Secret token used to authorize the keepalive cron job
CRON_SECRET=

# ============================================================
#  Analytics (optional)
# ============================================================
# Microsoft Clarity project ID — only included in production builds
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
